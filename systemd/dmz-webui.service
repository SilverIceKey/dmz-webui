[Unit]
Description=DMZ WebUI Management Service
After=network.target nftables.service
Wants=nftables.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/dmz-webui/backend
Environment=PYTHONUNBUFFERED=1
Environment=DMZ_SECRET_KEY=<CHANGE_ME>
ExecStartPre=/bin/sh -c 'echo 1 > /proc/sys/net/ipv4/ip_forward && echo 1 > /proc/sys/net/ipv6/conf/all/forwarding'
ExecStart=/opt/dmz-webui/venv/bin/uvicorn main:app --host 0.0.0.0 --port 5000 --workers 2
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
