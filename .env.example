# DMZ WebUI 环境变量示例
# 复制为 .env 并填入实际值（.env 不会被提交到 Git）

# JWT 签名密钥，生产环境必须修改为强随机字符串
DMZ_SECRET_KEY=replace-with-a-strong-random-secret

# 公网域名（用于 Caddy 反代配置生成）
DMZ_DOMAIN=example.com

# WebUI 后端监听地址（Caddy 反代目标）
DMZ_WEBUI_HOST=127.0.0.1

# Cloudflare DNS 认证（用于自动签发 Let's Encrypt 证书，可选）
# CF_API_KEY=your-cloudflare-api-key
# CF_EMAIL=your-cloudflare-email
